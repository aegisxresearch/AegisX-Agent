# AegisX Agent Configuration
# Copy this to .env and fill in your values

# === LLM Provider ===
# Options: openai, anthropic, ollama, groq, custom
AEGISX_LLM_PROVIDER=openai

# OpenAI
AEGISX_OPENAI_API_KEY=sk-...
AEGISX_OPENAI_MODEL=gpt-4o

# Anthropic
# AEGISX_ANTHROPIC_API_KEY=sk-ant-...
# AEGISX_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Ollama (local)
# AEGISX_OLLAMA_BASE_URL=http://localhost:11434
# AEGISX_OLLAMA_MODEL=llama3.1

# Groq (fast)
# AEGISX_GROQ_API_KEY=gsk_...
# AEGISX_GROQ_MODEL=llama-3.1-70b-versatile

# Custom (ANY OpenAI-compatible endpoint)
# AEGISX_CUSTOM_BASE_URL=https://api.together.xyz/v1
# AEGISX_CUSTOM_API_KEY=your-key
# AEGISX_CUSTOM_MODEL=meta-llama/Llama-3-70b-chat-hf

# === Agent Settings ===
# AEGISX_MAX_ITERATIONS=15
# AEGISX_TEMPERATURE=0.7
# AEGISX_MAX_TOKENS=4096
# AEGISX_PERSONA=default

# === Features ===
# AEGISX_MEMORY_ENABLED=true
# AEGISX_RAG_ENABLED=true
# AEGISX_CODE_EXECUTION_ENABLED=true
# AEGISX_WEB_SEARCH_ENABLED=true
# AEGISX_SHELL_ENABLED=false
