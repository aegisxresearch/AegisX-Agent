# Utopia Agent Configuration
# Copy this to .env and fill in your values

# === LLM Provider ===
# Options: openai, anthropic, ollama, groq, custom
UTOPIA_LLM_PROVIDER=openai

# OpenAI
UTOPIA_OPENAI_API_KEY=sk-...
UTOPIA_OPENAI_MODEL=gpt-4o

# Anthropic
# UTOPIA_ANTHROPIC_API_KEY=sk-ant-...
# UTOPIA_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Ollama (local)
# UTOPIA_OLLAMA_BASE_URL=http://localhost:11434
# UTOPIA_OLLAMA_MODEL=llama3.1

# Groq (fast)
# UTOPIA_GROQ_API_KEY=gsk_...
# UTOPIA_GROQ_MODEL=llama-3.1-70b-versatile

# Custom (ANY OpenAI-compatible endpoint)
# UTOPIA_CUSTOM_BASE_URL=https://api.together.xyz/v1
# UTOPIA_CUSTOM_API_KEY=your-key
# UTOPIA_CUSTOM_MODEL=meta-llama/Llama-3-70b-chat-hf

# === Agent Settings ===
# UTOPIA_MAX_ITERATIONS=15
# UTOPIA_TEMPERATURE=0.7
# UTOPIA_MAX_TOKENS=4096
# UTOPIA_PERSONA=default

# === Features ===
# UTOPIA_MEMORY_ENABLED=true
# UTOPIA_RAG_ENABLED=true
# UTOPIA_CODE_EXECUTION_ENABLED=true
# UTOPIA_WEB_SEARCH_ENABLED=true
# UTOPIA_SHELL_ENABLED=false
